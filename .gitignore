# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 与 project.md 必须进版本库）
# project.md = 本 fork 各项改动的背景、设计取舍与验证记录，随代码一起公开，
# 便于 review 时理解「为什么这么改」。
*.md
!README.md
!project.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
